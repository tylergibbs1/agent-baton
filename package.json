{
  "name": "agent-baton",
  "version": "0.5.0",
  "description": "Continue local agent conversations across Claude Code and Codex.",
  "type": "module",
  "bin": {
    "baton": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test tests/bridge.test.ts tests/agent.test.ts",
    "test:native": "bun test tests/native.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/baton"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "src",
    "README.md",
    "AGENT.md",
    "skills",
    "LICENSE"
  ],
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@types/bun": "^1.3.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tylergibbs1/agent-baton.git"
  },
  "bugs": {
    "url": "https://github.com/tylergibbs1/agent-baton/issues"
  },
  "homepage": "https://github.com/tylergibbs1/agent-baton#readme",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "chatgpt",
    "cli",
    "sessions",
    "agents"
  ]
}
